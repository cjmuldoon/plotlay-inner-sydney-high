table Site
	lineageTag: a7d6475e-c899-3b72-24d6-facc8cb0ead6

	/// The three NSW Cadastre lots, as one shape in Plotlay
	measure 'Grounds m2' = SUM ( Site[grounds_m2] )
		formatString: #,0
		displayFolder: Site
		lineageTag: 14f2bd6b-ffd2-327a-1285-e3600ac3b11b

	/// The podium and the heritage buildings; the tower stands on the podium and is not counted again
	measure 'Site footprint m2' = CALCULATE ( SUM ( Buildings[footprint_m2] ), REMOVEFILTERS ( Buildings ), Buildings[key] <> "T" )
		formatString: #,0
		displayFolder: Site
		lineageTag: 0dd518e1-8565-34a7-7ce4-2ab9f65582a1

	/// Every building, estimated: footprint times storeys
	measure 'Floor total m2 estimated' = CALCULATE ( SUM ( Buildings[floor_m2_est] ), REMOVEFILTERS ( Buildings ) )
		formatString: #,0
		displayFolder: Site
		lineageTag: a81b2863-9c1d-6535-1a7d-97aeb67fc9b8

	/// Floor space (estimated) over the site area
	measure 'Floor to grounds' = DIVIDE ( [Floor total m2 estimated], [Grounds m2] )
		formatString: 0.00
		displayFolder: Site
		lineageTag: e8ee9700-77d7-e65a-0da9-bf632ccf89cb

	/// Floor space (estimated) over the places the school was built for
	measure 'Floor per place estimated' = DIVIDE ( [Floor total m2 estimated], SUM ( Site[capacity] ) )
		formatString: 0.0
		displayFolder: Site
		lineageTag: d493f01f-1fe3-6171-d36a-2de9138ba046

	/// The year the per-year measures use: the year picked, the latest when none is
	measure 'Year shown' = MAX ( Years[year] )
		formatString: 0
		displayFolder: Per year
		lineageTag: b72f732c-3c29-ad44-275a-c0b8a276ff96

	/// NSW Department of Education headcount, the school as a whole
	measure Students =
			VAR y = [Year shown]
			RETURN CALCULATE ( SUM ( Enrolments[students] ), Years[year] = y )
		formatString: #,0
		displayFolder: Per year
		lineageTag: b214b1f7-3b27-058e-4939-959669ba984c

	/// Estimated floor space of the buildings in use that year (heritage from 2020, new building from 2021)
	measure 'Floor in use m2 estimated' =
			VAR y = [Year shown]
			RETURN CALCULATE ( SUM ( Buildings[floor_m2_est] ), REMOVEFILTERS ( Buildings ), Buildings[in_use_from] <= y )
		formatString: #,0
		displayFolder: Per year
		lineageTag: 7d993a5f-6ef3-cc10-919d-741717fcf858

	/// The same figure from site/floor_in_use.csv, as a check
	measure 'Floor in use m2 plan table' =
			VAR y = [Year shown]
			RETURN CALCULATE ( SUM ( FloorInUse[floor_in_use_m2_est] ), Years[year] = y )
		formatString: #,0
		displayFolder: Per year
		lineageTag: 93661dc9-7406-9b0e-07c1-4bb9efcadbbb

	/// Site level: floor in use (estimated) over the year headcount
	measure 'Floor per student estimated' = DIVIDE ( [Floor in use m2 estimated], [Students] )
		formatString: #,0.0
		displayFolder: Per year
		lineageTag: a6e2d093-223e-b31e-1066-dfa1b0a45638

	/// Site level: the grounds over the year headcount
	measure 'Grounds per student' = DIVIDE ( [Grounds m2], [Students] )
		formatString: #,0.0
		displayFolder: Per year
		lineageTag: 9ee86f92-d5c1-f02f-b478-e392ce2f0b92

	column key
		dataType: string
		lineageTag: 03ede82b-4a59-3a01-dbc3-fe13d1513195
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = Automatic

	column school_name
		dataType: string
		lineageTag: 7f67a2f3-aafe-15d7-ee0e-3204726ceb4e
		summarizeBy: none
		sourceColumn: school_name

		annotation SummarizationSetBy = Automatic

	column grounds_m2
		dataType: double
		formatString: #,0
		lineageTag: a10cc50f-a42a-6484-7709-7fe0270e0227
		summarizeBy: none
		sourceColumn: grounds_m2

		annotation SummarizationSetBy = Automatic

	column lots
		dataType: string
		lineageTag: 70d03179-52b3-584e-9d6f-f4a4f6adbc7e
		summarizeBy: none
		sourceColumn: lots

		annotation SummarizationSetBy = Automatic

	column buildings
		dataType: int64
		formatString: 0
		lineageTag: f51a1102-cc3e-f3e0-8244-267481d624e7
		summarizeBy: none
		sourceColumn: buildings

		annotation SummarizationSetBy = Automatic

	column footprint_m2
		dataType: double
		formatString: #,0
		lineageTag: fa04ff60-3cae-362a-b59d-8e583bea6f2d
		summarizeBy: none
		sourceColumn: footprint_m2

		annotation SummarizationSetBy = Automatic

	column floor_m2_est
		dataType: double
		formatString: #,0
		lineageTag: 9e175008-3048-0eb5-065e-7739a2f0d772
		summarizeBy: none
		sourceColumn: floor_m2_est

		annotation SummarizationSetBy = Automatic

	column students_2025
		dataType: int64
		formatString: #,0
		lineageTag: e0fbb5e2-15af-e641-fcd6-f32538b7eec3
		summarizeBy: none
		sourceColumn: students_2025

		annotation SummarizationSetBy = Automatic

	column capacity
		dataType: int64
		formatString: #,0
		lineageTag: e03d4d71-66de-2167-061e-2ebc490d2077
		summarizeBy: none
		sourceColumn: capacity

		annotation SummarizationSetBy = Automatic

	partition Site = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("site/site_rollup.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "school_name", "grounds_m2", "lots", "buildings", "footprint_m2", "floor_m2_est", "students_2025", "capacity"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"school_name", type text}, {"grounds_m2", type number}, {"lots", type text}, {"buildings", Int64.Type}, {"footprint_m2", type number}, {"floor_m2_est", type number}, {"students_2025", Int64.Type}, {"capacity", Int64.Type}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
