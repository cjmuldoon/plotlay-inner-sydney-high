	partition Buildings = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("buildings/buildings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "name", "part", "storeys", "plates_above_street", "height_m", "height_basis", "levels", "in_use_from", "outline_from", "note", "footprint_m2", "floor_m2_est"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"name", type text}, {"part", type text}, {"storeys", Int64.Type}, {"plates_above_street", Int64.Type}, {"height_m", type number}, {"height_basis", type text}, {"levels", type text}, {"in_use_from", Int64.Type}, {"outline_from", type text}, {"note", type text}, {"footprint_m2", type number}, {"floor_m2_est", type number}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table

