table Buildings
	lineageTag: 9fdd5aad-7ea5-28df-6738-692b788cee0a

	measure 'Buildings count' = DISTINCTCOUNT ( Buildings[key] )
		formatString: 0
		displayFolder: Buildings
		lineageTag: 3ef496a4-7017-ec71-52be-c34c27d8ae7a

	/// Each shape as drawn in Plotlay; the tower stands on the podium, so do not add it to the site
	measure 'Footprint m2' = SUM ( Buildings[footprint_m2] )
		formatString: #,0
		displayFolder: Buildings
		lineageTag: c0b40305-1637-e7c0-8ae0-db21a49011c9

	/// Estimated: footprint times storeys, every storey over the whole footprint
	measure 'Floor m2 estimated' = SUM ( Buildings[floor_m2_est] )
		formatString: #,0
		displayFolder: Buildings
		lineageTag: 19de14cf-b67a-e852-3847-4628ba9dbe4c

	/// Share of the school floor space (estimated)
	measure 'Floor share' = DIVIDE ( [Floor m2 estimated], CALCULATE ( [Floor m2 estimated], REMOVEFILTERS ( Buildings ) ) )
		formatString: 0.0%
		displayFolder: Buildings
		lineageTag: 9a4c27c7-7368-7f16-c1a3-afa6a4fc1d49

